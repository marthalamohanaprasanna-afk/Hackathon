# ==========================================
# DocuMind AI - Environment Configuration Template
# ==========================================

# ------------------------------------------
# Backend API Configuration (apps/api/.env)
# ------------------------------------------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL & Auth Credentials
# Obtain from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=documind-documents

# Google Gemini AI Configuration
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# File Upload Constraints
MAX_FILE_SIZE_MB=25
MAX_FILES_PER_UPLOAD=10

# OCR Engine Settings
OCR_LANGUAGE=eng

# AI Processing Limits & Retries
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ------------------------------------------
# Frontend Web App Configuration (apps/web/.env)
# ------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_BASE_URL=http://localhost:5000/api
